OPENAI_API_KEY=
# "mock" (or an empty OPENAI_API_KEY) gives canned AI replies without calling OpenAI.
OPENAI_MODEL=
DATABASE_URL=
# Demo only (npm run demo). Leave DEMO_PASSWORD empty for normal local dev (no password).
DEMO_PASSWORD=
ADMIN_PASSWORD=
# Optional: session-clock speed-up, overrides demoTimeScale in config/study.json (npm run demo uses 0.05).
DEMO_TIME_SCALE=
# Optional: real Qualtrics survey links (anonymous links). Override baselineSurveyUrl / endSurveyUrl in
# config/study.json, which stay on the local placeholder in the public repo. See README "Qualtrics setup".
BASELINE_SURVEY_URL=
END_SURVEY_URL=
# Optional: Qualtrics API token (Account settings > Qualtrics IDs), only for configuring or checking the surveys via the API.
QUALTRICS_API_TOKEN=
